# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Storage (optional; defaults shown)
# DB_PATH=tmp/db.sqlite3
# CONTENT_DIR=../cp-trainer-content

# Also play draft problems (author preview; all problems are drafts until summaries exist)
# CONTENT_INCLUDE_DRAFTS=true

# Content repo on GitHub, for "Report a problem" and the contribute page (default shown)
# CONTENT_REPO_URL=https://github.com/massicomar/cp-trainer-content

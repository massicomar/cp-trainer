# Copy to .env.docker (git-ignored) for `docker compose`.
# NODE_ENV, HOST, PORT, DB_PATH and CONTENT_DIR are set in docker-compose.yml.

# Public address. Caddy serves it and gets the certificate for it.
#   local test: https://localhost  (accept the browser's certificate warning once)
#   VPS:        https://cp.yourdomain.com
APP_URL=https://localhost

# Generate with: node ace generate:key --show
APP_KEY=

LOG_LEVEL=info
TZ=UTC
SESSION_DRIVER=cookie

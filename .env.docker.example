# Copy to .env.docker (git-ignored) for `docker compose`.
# NODE_ENV, HOST, PORT, DB_PATH and CONTENT_DIR are set in docker-compose.yml.

# Public address of the app.
#   local test: https://localhost         (the local-profile Caddy serves it)
#   VPS:        https://cp.massi.com.ar   (must match the site block in ~/sites/caddy/Caddyfile)
APP_URL=https://localhost

# Generate with: node ace generate:key --show   (or: openssl rand -base64 32)
APP_KEY=

LOG_LEVEL=info
TZ=UTC
SESSION_DRIVER=cookie

# Optional: also play draft problems (author preview)
# CONTENT_INCLUDE_DRAFTS=true

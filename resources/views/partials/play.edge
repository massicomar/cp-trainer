{{--
  The whole lesson area. Every form posts normally (works without JS) and
  HTMX swaps this element with the server's response.
--}}
@let(meta =
  play.type === 'drill'
    ? t('messages.drills.label')
    : t('messages.play.problemOf', { number: play.problemNumber, count: play.problemCount }))
<div id="play" class="play">
  <header class="play__top">
    <ol class="progress" aria-label="{{ meta }}">
      @each(step in play.progress)
        <li
          class="progress__step progress__step--{{ step.state }} {{ step.drill ? 'progress__step--drill' : '' }}"
        ></li>
      @end
    </ol>
    <p class="play__meta">
      {{ meta }}
      <span class="pill">{{ play.subjectNames.join(' · ') }}</span>
    </p>
  </header>
  @if(play.type === 'drill')
    @include('partials/play_drill')
  @else
    @include('partials/play_problem')
  @end
</div>

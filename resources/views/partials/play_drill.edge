{{-- A drill: one short question about complexities, then its arithmetic. --}}
@let(base = `/lessons/${play.lesson.id}`)
@let(drill = play.drill)
<section class="layer drill" aria-live="polite">
  <h2 class="layer__prompt">{{{ math(t(drill.prompt.key, drill.prompt.params)) }}}</h2>
  @if(!play.feedback)
    <form
      class="options {{ drill.kind === 'fits' ? 'options--pair' : '' }}"
      method="post"
      action="{{ base }}/answer"
      hx-post="{{ base }}/answer"
      hx-target="#play"
      hx-swap="outerHTML"
    >
      {{ csrfField() }}
      <input type="hidden" name="step" value="{{ play.stepToken }}" />
      @each(option in drill.options)
        <button type="submit" name="option" value="{{ option.id }}" class="option">
          @if(option.textKey)
            {{ t(option.textKey) }}
          @else
            {{{ math(option.text) }}}
          @end
        </button>
      @end
    </form>

    <div class="layer__footer">
      <form
        method="post"
        action="{{ base }}/give-up"
        hx-post="{{ base }}/give-up"
        hx-target="#play"
        hx-swap="outerHTML"
      >
        {{ csrfField() }}
        <input type="hidden" name="step" value="{{ play.stepToken }}" />
        <button type="submit" class="button button--ghost">{{ t('messages.play.giveUp') }}</button>
      </form>
      <form
        method="post"
        action="{{ base }}/skip"
        hx-post="{{ base }}/skip"
        hx-target="#play"
        hx-swap="outerHTML"
      >
        {{ csrfField() }}
        <button type="submit" class="button button--ghost">{{ t('messages.drills.skip') }}</button>
      </form>
    </div>
  @else
    <ul class="options options--answered {{ drill.kind === 'fits' ? 'options--pair' : '' }}">
      @each(option in play.feedback.options)
        <li class="option option--{{ option.mark }} {{ option.picked ? 'option--picked' : '' }}">
          @if(option.textKey)
            <span>{{ t(option.textKey) }}</span>
          @else
            <span>{{{ math(option.text) }}}</span>
          @end
          @if(option.picked)
            <span class="option__tag">{{ t('messages.play.yourAnswer') }}</span>
          @end
        </li>
      @end
    </ul>

    <div class="verdict verdict--{{ play.feedback.outcome }}" role="status">
      @if(play.feedback.outcome === 'correct')
        <p class="verdict__title">{{ t('messages.play.verdict.correct') }}</p>
      @else
        <p class="verdict__title">
          {{
            t(
              play.feedback.outcome === 'wrong'
                ? 'messages.play.verdict.wrong'
                : 'messages.play.verdict.gaveUp',
            )
          }}
        </p>
        <p class="verdict__answer">
          @if(drill.expected.textKey)
            {{ t(drill.expected.textKey) }}
          @else
            {{{ math(drill.expected.text) }}}
          @end
        </p>
      @end
      @if(drill.explanation.messages)
        <p class="verdict__explanation">
          @each(message in drill.explanation.messages)
            {{{ math(t(message.key, message.params)) }}}
          @end
        </p>
      @else
        <p class="verdict__explanation" lang="{{ localizedLang(drill.explanation.textEs) }}">
          {{{ math(localized(drill.explanation.text, drill.explanation.textEs)) }}}
        </p>
      @end
    </div>

    <form
      method="post"
      action="{{ base }}/continue"
      hx-post="{{ base }}/continue"
      hx-target="#play"
      hx-swap="outerHTML"
    >
      {{ csrfField() }}
      <button type="submit" class="button button--primary button--wide" autofocus>
        {{ t(`messages.play.${play.next}`) }}
      </button>
    </form>
  @end

  <p class="report">
    <a href="{{ base }}/report?step={{ play.stepToken }}" target="_blank" rel="noopener">
      {{ t('messages.play.report') }}
    </a>
  </p>
</section>

{{-- The generated file and its checks. HTMX swaps this after every form change. --}}
<aside id="preview" class="builder__preview" aria-live="polite">
  <h2>{{ t('messages.contribute.preview.heading') }}</h2>
  @if(preview.path)
    <p>
      {{ t('messages.contribute.preview.saveAsBefore') }}
      <code>{{ preview.path }}</code>
      {{ t('messages.contribute.preview.saveAsAfter') }}
    </p>
  @else
    <p class="muted">{{ t('messages.contribute.preview.noPath') }}</p>
  @end
  @if(!preview.started)
    <p class="muted">{{ t('messages.contribute.preview.notStarted') }}</p>
  @elseif(preview.check.errors.length)
    <div class="notice notice--error">
      <strong>{{ t('messages.contribute.preview.rejected') }}</strong>
      <ul>
        @each(message in preview.check.errors)
          <li>{{ message }}</li>
        @end
      </ul>
    </div>
  @else
    <p class="notice notice--ok">{{ t('messages.contribute.preview.ok') }}</p>
  @end
  @if(preview.started && preview.check.warnings.length)
    <div class="notice notice--warn">
      <ul>
        @each(message in preview.check.warnings)
          <li>{{ message }}</li>
        @end
      </ul>
    </div>
  @end

  <div class="actions">
    <button
      type="button"
      class="button"
      data-copy="#preview-json"
      data-copied="{{ t('messages.contribute.preview.copied') }}"
    >
      {{ t('messages.contribute.preview.copy') }}
    </button>
    <a class="button" href="{{ preview.downloadHref }}" download="{{ preview.downloadName }}">
      {{ t('messages.contribute.preview.download') }}
    </a>
    @if(preview.github)
      <a class="button" href="{{ preview.github.url }}" target="_blank" rel="noopener">
        {{
          preview.github.prefilled
            ? t('messages.contribute.preview.openGithub')
            : t('messages.contribute.preview.editGithub')
        }}
      </a>
    @end
  </div>
  @if(preview.statement)
    <h3>{{ t('messages.contribute.preview.statement') }}</h3>
    <div class="problem">
      <p class="problem__summary" lang="en">{{{ math(preview.statement) }}}</p>
    </div>
  @end

  <pre class="json"><code id="preview-json">{{ preview.json }}</code></pre>
</aside>

{{--
  One extra layer (DP state, DP transition, …). It's its own rows scope, so
  "Add option" adds to this layer only.
--}}
@let(prefix = `layers[${$props.get('index')}]`)
@let(layer = $props.get('layer') ?? {})
@let(options = layer.options && layer.options.length ? layer.options : [{}, {}, {}, {}])
@let(accepted = layer.accepted ?? [])
@let(es = $props.get('es') ?? {})
@let(whyEs = es.why ?? {})
<div class="layer-editor" data-row data-rows-scope>
  <div class="layer-editor__head">
    <label class="field">
      <span>{{ t('messages.contribute.layer.key') }}</span>
      <input
        name="{{ prefix }}[key]"
        value="{{ layer.key ?? '' }}"
        class="input"
        placeholder="dp-state"
      />
    </label>
    <label class="field">
      <span>{{ t('messages.contribute.layer.kind') }}</span>
      <select name="{{ prefix }}[kind]" class="input">
        @each(kind in $props.get('kinds'))
          <option value="{{ kind }}" {{ kind === layer.kind ? 'selected' : '' }}>{{ kind }}</option>
        @end
      </select>
    </label>
    <button type="button" class="row__remove" data-remove-row>
      {{ t('messages.contribute.layer.remove') }}
    </button>
  </div>
  <label class="field">
    <span>{{ t('messages.contribute.layer.prompt') }}</span>
    <input name="{{ prefix }}[prompt]" value="{{ layer.prompt ?? '' }}" class="input" />
  </label>
  <p class="hint">{{ t('messages.contribute.layer.optionsHint') }}</p>
  <div class="rows" data-rows="options" data-next="{{ options.length }}">
    @each((option, j) in options)
      @!contribute.optionRow({
        prefix,
        index: j,
        option,
        whyEs: whyEs[option.id],
        correct: accepted.includes(option.id),
      })
    @end
  </div>
  <template data-row-template="options" data-placeholder="__j__">
    @!contribute.optionRow({ prefix, index: '__j__', option: {}, correct: false })
  </template>
  <button type="button" class="link-button" data-add-row="options">
    {{ t('messages.contribute.layer.addOption') }}
  </button>
  <label class="field">
    <span>{{ t('messages.contribute.layer.explanation') }}</span>
    <textarea
      name="{{ prefix }}[explanation]"
      class="input"
      rows="2"
    >{{ layer.explanation ?? '' }}</textarea>
  </label>
  <label class="field">
    <span>
      {{ t('messages.contribute.layer.explanationEs') }}
      <small>{{ t('messages.contribute.layer.optional') }}</small>
    </span>
    <textarea
      name="{{ prefix }}[explanationEs]"
      class="input"
      rows="2"
      lang="es"
    >{{ es.explanation ?? '' }}</textarea>
  </label>
</div>

{{-- One option of an extra layer. Ids (a, b, c…) come from the order of the rows. --}}
@let(name = `${$props.get('prefix')}[options][${$props.get('index')}]`)
@let(option = $props.get('option') ?? {})
<div class="row row--option" data-row>
  <label class="check">
    <input
      type="checkbox"
      name="{{ name }}[correct]"
      {{ $props.get('correct') ? 'checked' : '' }}
    />
    <span>{{ t('messages.contribute.layer.correct') }}</span>
  </label>
  <input
    name="{{ name }}[text]"
    value="{{ option.text ?? '' }}"
    class="input"
    placeholder="{{ t('messages.contribute.layer.optionText') }}"
  />
  <input
    name="{{ name }}[why]"
    value="{{ option.why ?? '' }}"
    class="input"
    placeholder="{{ t('messages.contribute.layer.why') }}"
  />
  <input
    name="{{ name }}[whyEs]"
    value="{{ $props.get('whyEs') ?? '' }}"
    class="input"
    lang="es"
    aria-label="{{ t('messages.contribute.layer.whyEsLabel') }}"
    placeholder="{{ t('messages.contribute.layer.whyEs') }}"
  />
  <button
    type="button"
    class="row__remove"
    data-remove-row
    aria-label="{{ t('messages.contribute.layer.removeOption') }}"
  >
    ×
  </button>
</div>

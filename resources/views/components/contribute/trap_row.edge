{{-- One trap: English, plus its optional Spanish version. --}}
@let(i = $props.get('index'))
<div class="row row--bilingual" data-row>
  <input
    name="traps[{{ i }}][en]"
    value="{{ $props.get('trap') ?? '' }}"
    class="input"
    aria-label="{{ t('messages.contribute.fields.trap') }}"
    placeholder="{{ t('messages.contribute.fields.trap') }}"
  />
  <input
    name="traps[{{ i }}][es]"
    value="{{ $props.get('trapEs') ?? '' }}"
    class="input"
    lang="es"
    aria-label="{{ t('messages.contribute.fields.trapEs') }}"
    placeholder="{{ t('messages.contribute.fields.trapEsPlaceholder') }}"
  />
  <button
    type="button"
    class="row__remove"
    data-remove-row
    aria-label="{{ t('messages.contribute.fields.remove') }}"
  >
    ×
  </button>
</div>

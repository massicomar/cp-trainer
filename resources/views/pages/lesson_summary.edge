@layouts.main({ title: t('messages.summary.pageTitle') })
  <h1>{{ t('messages.summary.heading') }}</h1>

  <ul class="scores">
    @each(score in summary.scores)
      <li class="score">
        <span class="score__label">{{ t(`messages.kinds.${score.kind}`, {}, score.label) }}</span>
        <strong class="score__value">{{ score.right }}/{{ score.total }}</strong>
      </li>
    @end
  </ul>

  <ol class="results">
    @each((item, index) in summary.problems)
      <li class="result">
        <h2 class="result__title">
          <a href="{{ item.problem.url }}" target="_blank" rel="noopener noreferrer">
            {{ item.problem.title }}
          </a>
          <small>{{ item.problem.source }} · {{ t(`messages.tiers.${item.problem.tier}`) }}</small>
        </h2>
        @!credit({ problem: item.problem })
        <ul class="marks">
          @each(result in item.results)
            <li class="mark mark--{{ result.outcome }}">
              {{ t(`messages.kinds.${result.kind}`, {}, result.label) }}:
              {{ t(`messages.outcomes.${result.outcome}`) }}
            </li>
          @end
        </ul>
        <p class="result__observation">
          <strong>{{ t('messages.summary.keyObservation') }}</strong>
          <span lang="{{ localizedLang(item.problem.explanationEs) }}">
            {{{
              math(
                localized(item.problem.explanationMd, item.problem.explanationEs),
              )
            }}}
          </span>
        </p>
        @if(item.problem.traps.length)
          <ul class="traps">
            @each((trap, i) in item.problem.traps)
              <li lang="{{ localizedLang(item.problem.trapsEs[i]) }}">
                {{{ math(localized(trap, item.problem.trapsEs[i])) }}}
              </li>
            @end
          </ul>
        @end

        <p class="report">
          <a
            href="/lessons/{{ summary.lesson.id }}/report?problem={{ index }}"
            target="_blank"
            rel="noopener"
          >
            {{ t('messages.play.report') }}
          </a>
        </p>
      </li>
    @end
  </ol>

  <div class="actions">
    <form method="post" action="/lessons/{{ summary.lesson.id }}/next">
      {{ csrfField() }}
      <button type="submit" class="button button--primary">{{ t('messages.summary.next') }}</button>
    </form>
    <a class="button" href="{{ changeUrl }}">{{ t('messages.summary.change') }}</a>
  </div>
@end

@layouts.main({ title: t('messages.setup.pageTitle') })
  <h1>{{ t('messages.setup.heading') }}</h1>
  <p class="muted">{{ t('messages.setup.intro', { size: lessonSize }) }}</p>

  @flashMessage('error')
    <p class="notice notice--error" role="alert">{{ $message }}</p>
  @end

  {{--
    Toggling a chip refreshes the match count (HTMX GET on change).
    Start submits the form normally.
  --}}
  <form
    id="setup"
    class="setup"
    method="post"
    action="/lessons"
    hx-get="/selection/count"
    hx-trigger="change"
    hx-target="#selection-count"
    hx-swap="outerHTML"
  >
    {{ csrfField() }}

    <fieldset class="setup__group">
      <legend>{{ t('messages.setup.subjects') }}</legend>
      <div class="presets">
        <button type="button" class="link-button" data-preset-subjects="{{ presets.all }}">
          {{ t('messages.setup.presets.all') }}
        </button>
        @if(presets.dp)
          <button type="button" class="link-button" data-preset-subjects="{{ presets.dp }}">
            {{ t('messages.setup.presets.dp') }}
          </button>
        @end
        @if(presets.last)
          <button
            type="button"
            class="link-button"
            data-preset-subjects="{{ presets.last.subjects.join(',') }}"
            data-preset-tiers="{{ presets.last.tiers.join(',') }}"
            data-preset-problems="{{ presets.last.includeCommunity ? 'all' : 'official' }}"
          >
            {{ t('messages.setup.presets.last') }}
          </button>
        @end
      </div>
      <div class="chips">
        @each(subject in subjects)
          <label class="chip">
            <input
              type="checkbox"
              name="subjects[]"
              value="{{ subject.id }}"
              {{ current.subjects.includes(subject.id) ? 'checked' : '' }}
            />
            <span>{{ subject.name }} <small>{{ perSubject[subject.id] ?? 0 }}</small></span>
          </label>
        @end
      </div>
      @inputError('subjects')
        <p class="field-error">{{ t('messages.setup.errors.subjects') }}</p>
      @end
    </fieldset>

    <fieldset class="setup__group">
      <legend>{{ t('messages.setup.difficulty') }}</legend>
      <div class="chips">
        @each(tier in tiers)
          <label class="chip">
            <input
              type="checkbox"
              name="tiers[]"
              value="{{ tier }}"
              {{ current.tiers.includes(tier) ? 'checked' : '' }}
            />
            <span>{{ t(`messages.tiers.${tier}`) }}</span>
          </label>
        @end
      </div>
      @inputError('tiers')
        <p class="field-error">{{ t('messages.setup.errors.tiers') }}</p>
      @end
    </fieldset>

    <fieldset class="setup__group">
      <legend>{{ t('messages.setup.problems') }}</legend>
      <div class="chips">
        @each(option in ['all', 'official'])
          <label class="chip">
            <input
              type="radio"
              name="problems"
              value="{{ option }}"
              {{ (option === 'all') === current.includeCommunity ? 'checked' : '' }}
            />
            <span>{{ t(`messages.setup.collections.${option}`) }}</span>
          </label>
        @end
      </div>
    </fieldset>

    @include('partials/selection_count')
  </form>
@end

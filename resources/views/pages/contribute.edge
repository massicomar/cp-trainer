@layouts.main({ title: t('messages.contribute.pageTitle') })
  <h1>{{ t('messages.contribute.heading') }}</h1>
  <p class="muted">
    {{ t('messages.contribute.intro') }}
    <a href="{{ repoUrl }}/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">
      {{ t('messages.contribute.guide') }}
    </a>
  </p>
  <p><a href="/contribute">{{ t('messages.contribute.otherWays') }}</a></p>
  @flashMessage('notice')
    <p class="notice">{{ $message }}</p>
  @end
  @if(notice === 'fetched')
    <p class="notice notice--ok">
      {{ t('messages.contribute.notices.fetched', { judge }) }}
    </p>
  @elseif(notice === 'blocked')
    <p class="notice notice--warn">
      {{ t('messages.contribute.notices.blockedBefore', { judge }) }}
      <code>node ace content:fetch-statements</code>
      {{ t('messages.contribute.notices.blockedAfter') }}
    </p>
  @elseif(notice === 'failed')
    <p class="notice notice--warn">
      {{ t('messages.contribute.notices.failed', { judge }) }}
    </p>
  @end
  @if(notFound)
    <p class="notice notice--error">
      {{ t('messages.contribute.notices.notFound', { id: notFound }) }}
    </p>
  @end
  @if(editing)
    <p class="notice">
      {{ t('messages.contribute.notices.editing') }}
      <strong>{{ editing }}</strong>. {{ t('messages.contribute.notices.editingNote') }}
    </p>
  @end

  <div class="builder">
    <form
      id="builder"
      class="builder__form"
      method="post"
      action="/contribute"
      hx-post="/contribute"
      hx-trigger="input delay:500ms, change"
      hx-target="#preview"
      hx-swap="outerHTML"
      data-rows-scope
    >
      {{ csrfField() }}
      <input type="hidden" name="editing" value="{{ editing ?? '' }}" />

      <fieldset class="builder__group">
        <legend>{{ t('messages.contribute.groups.problem') }}</legend>
        <label class="field">
          <span>
            {{ t('messages.contribute.fields.id') }}
            <small>{{ t('messages.contribute.fields.idHint') }}</small>
          </span>
          <input
            name="id"
            value="{{ problem.id }}"
            class="input"
            placeholder="cses-1158"
            required
          />
        </label>
        <label class="field">
          <span>
            {{ t('messages.contribute.fields.title') }}
            <small>{{ t('messages.contribute.fields.titleHint') }}</small>
          </span>
          <input name="title" value="{{ problem.title }}" class="input" />
        </label>
        <div class="field-row">
          <label class="field">
            <span>{{ t('messages.contribute.fields.judge') }}</span>
            <select name="source" class="input">
              @each(source in choices.sources)
                <option value="{{ source }}" {{ source === problem.source ? 'selected' : '' }}>
                  {{ source }}
                </option>
              @end
            </select>
          </label>
          <label class="field field--wide">
            <span>{{ t('messages.contribute.fields.url') }}</span>
            <input
              name="url"
              value="{{ problem.url }}"
              class="input"
              type="url"
              placeholder="https://cses.fi/problemset/task/1158"
            />
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>{{ t('messages.contribute.fields.tier') }}</span>
            <select name="difficulty[tier]" class="input">
              @each(tier in choices.tiers)
                <option value="{{ tier }}" {{ tier === problem.difficulty.tier ? 'selected' : '' }}>
                  {{ tier }}
                </option>
              @end
            </select>
          </label>
          <label class="field">
            <span>{{ t('messages.contribute.fields.scale') }}</span>
            <select name="difficulty[scale]" class="input">
              @each(scale in choices.scales)
                <option
                  value="{{ scale }}"
                  {{ scale === problem.difficulty.scale ? 'selected' : '' }}
                >
                  {{ scale }}
                </option>
              @end
            </select>
          </label>
          <label class="field">
            <span>{{ t('messages.contribute.fields.rating') }} <small>{{ t('messages.contribute.fields.ratingHint') }}</small></span>
            <input name="difficulty[value]" value="{{ problem.difficulty.value }}" class="input" />
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>{{ t('messages.contribute.fields.status') }}</span>
            <select name="status" class="input">
              @each(status in ['draft', 'ready'])
                <option value="{{ status }}" {{ status === problem.status ? 'selected' : '' }}>
                  {{ status }}
                </option>
              @end
            </select>
          </label>
          <label class="field">
            <span>{{ t('messages.contribute.fields.collection') }}</span>
            <select name="collection" class="input">
              @each(collection in ['community', 'official'])
                <option
                  value="{{ collection }}"
                  {{ collection === problem.collection ? 'selected' : '' }}
                >
                  {{ collection }}
                </option>
              @end
            </select>
          </label>
          <label class="field">
            <span>{{ t('messages.contribute.fields.author') }}</span>
            <input
              name="author"
              value="{{ problem.author }}"
              class="input"
              autocomplete="username"
            />
          </label>
        </div>
      </fieldset>

      <fieldset class="builder__group">
        <legend>{{ t('messages.contribute.groups.reads') }}</legend>
        <label class="field">
          <span>
            {{ t('messages.contribute.fields.statement') }}
            <small>{{ t('messages.contribute.fields.statementHint') }}</small>
          </span>
          <textarea name="summary" class="input" rows="10">{{ problem.summary }}</textarea>
        </label>
        <label class="field">
          <span>{{ t('messages.contribute.fields.constraints') }} <small>{{ t('messages.contribute.fields.constraintsHint') }}</small></span>
          <input
            name="constraints[text]"
            value="{{ problem.constraints.text }}"
            class="input"
            placeholder="n ≤ 2e5, values ≤ 1e9"
          />
        </label>
        <label class="check">
          <input
            type="checkbox"
            name="constraints[verified]"
            {{ problem.constraints.verified ? 'checked' : '' }}
          />
          <span>{{ t('messages.contribute.fields.verified') }}</span>
        </label>
      </fieldset>

      <fieldset class="builder__group">
        <legend>{{ t('messages.contribute.groups.answers') }}</legend>
        <p class="hint">{{ t('messages.contribute.fields.answersHint') }}</p>

        <p class="field-label">{{ t('messages.contribute.fields.subjects') }}</p>
        <div class="rows" data-rows="subjects" data-next="{{ problem.answers.subjects.length }}">
          @each((answer, i) in problem.answers.subjects)
            @!contribute.subjectRow({ index: i, answer, subjects, roles })
          @end
        </div>
        <template data-row-template="subjects" data-placeholder="__i__">
          @!contribute.subjectRow({
            index: '__i__',
            answer: { id: '', role: 'accepted' },
            subjects,
            roles,
          })
        </template>
        <button type="button" class="link-button" data-add-row="subjects">{{ t('messages.contribute.fields.addSubject') }}</button>

        <p class="field-label">{{ t('messages.contribute.fields.techniques') }}</p>
        <div
          class="rows"
          data-rows="techniques"
          data-next="{{ problem.answers.techniques.length }}"
        >
          @each((answer, i) in problem.answers.techniques)
            @!contribute.techniqueRow({
              index: i,
              answer,
              groups: techniqueGroups,
              roles,
            })
          @end
        </div>
        <template data-row-template="techniques" data-placeholder="__i__">
          @!contribute.techniqueRow({
            index: '__i__',
            answer: { id: '', role: 'accepted' },
            groups: techniqueGroups,
            roles,
          })
        </template>
        <button type="button" class="link-button" data-add-row="techniques">
          {{ t('messages.contribute.fields.addTechnique') }}
        </button>

        <p class="field-label">
          {{ t('messages.contribute.fields.appearsIn') }}
          <small>{{ t('messages.contribute.fields.appearsInHint') }}</small>
        </p>
        <div class="chips">
          @each(subject in subjects)
            @if(!subject.hidden)
              <label class="chip">
                <input
                  type="checkbox"
                  name="appearsIn[]"
                  value="{{ subject.id }}"
                  {{
                    (problem.appearsIn ?? []).includes(subject.id)
                      ? 'checked'
                      : ''
                  }}
                />
                <span>{{ subject.name }}</span>
              </label>
            @end
          @end
        </div>
      </fieldset>

      <fieldset class="builder__group">
        <legend>{{ t('messages.contribute.groups.wrong') }}</legend>
        <p class="field-label">
          {{ t('messages.contribute.fields.distractors') }}
          <small>{{ t('messages.contribute.fields.distractorsHint') }}</small>
        </p>
        <div
          class="rows"
          data-rows="distractors"
          data-next="{{ (problem.distractors ?? []).length }}"
        >
          @each(distractor in problem.distractors)
            <div class="row" data-row>
              @!contribute.techniqueSelect({
                name: 'distractors[]',
                selected: distractor,
                groups: techniqueGroups,
                label: t('messages.contribute.fields.distractor'),
              })
              <button type="button" class="row__remove" data-remove-row aria-label="{{ t('messages.contribute.fields.remove') }}">
                ×
              </button>
            </div>
          @end
        </div>
        <template data-row-template="distractors" data-placeholder="__i__">
          <div class="row" data-row>
            @!contribute.techniqueSelect({
              name: 'distractors[]',
              selected: '',
              groups: techniqueGroups,
              label: t('messages.contribute.fields.distractor'),
            })
            <button type="button" class="row__remove" data-remove-row aria-label="{{ t('messages.contribute.fields.remove') }}">×</button>
          </div>
        </template>
        <button type="button" class="link-button" data-add-row="distractors">
          {{ t('messages.contribute.fields.addDistractor') }}
        </button>

        <p class="field-label">
          {{ t('messages.contribute.fields.pairWith') }} <small>{{ t('messages.contribute.fields.pairWithHint') }}</small>
        </p>
        <datalist id="problem-ids">
          @each(id in problemIds)
            <option value="{{ id }}"></option>
          @end
        </datalist>
        <div class="rows" data-rows="pairWith" data-next="{{ (problem.pairWith ?? []).length }}">
          @each(id in problem.pairWith)
            <div class="row" data-row>
              <input
                name="pairWith[]"
                value="{{ id }}"
                class="input"
                list="problem-ids"
                aria-label="{{ t('messages.contribute.start.problemId') }}"
              />
              <button type="button" class="row__remove" data-remove-row aria-label="{{ t('messages.contribute.fields.remove') }}">
                ×
              </button>
            </div>
          @end
        </div>
        <template data-row-template="pairWith" data-placeholder="__i__">
          <div class="row" data-row>
            <input name="pairWith[]" class="input" list="problem-ids" aria-label="{{ t('messages.contribute.start.problemId') }}" />
            <button type="button" class="row__remove" data-remove-row aria-label="{{ t('messages.contribute.fields.remove') }}">×</button>
          </div>
        </template>
        <button type="button" class="link-button" data-add-row="pairWith">{{ t('messages.contribute.fields.addPair') }}</button>
      </fieldset>

      <fieldset class="builder__group">
        <legend>{{ t('messages.contribute.groups.after') }}</legend>
        <label class="field">
          <span>
            {{ t('messages.contribute.fields.explanation') }}
            <small>{{ t('messages.contribute.fields.explanationHint') }}</small>
          </span>
          <textarea name="explanation" class="input" rows="3">{{ problem.explanation }}</textarea>
        </label>
        <label class="field">
          <span>
            {{ t('messages.contribute.fields.explanationEs') }} <small>{{ t('messages.contribute.fields.explanationEsHint') }}</small>
          </span>
          <textarea
            name="explanationEs"
            class="input"
            rows="3"
            lang="es"
          >{{ problem.es.explanation }}</textarea>
        </label>
        <p class="field-label">
          {{ t('messages.contribute.fields.traps') }} <small>{{ t('messages.contribute.fields.trapsHint') }}</small>
        </p>
        <div class="rows" data-rows="traps" data-next="{{ problem.traps.length }}">
          @each((trap, i) in problem.traps)
            @!contribute.trapRow({ index: i, trap, trapEs: problem.es.traps[i] })
          @end
        </div>
        <template data-row-template="traps" data-placeholder="__i__">
          @!contribute.trapRow({ index: '__i__', trap: '', trapEs: '' })
        </template>
        <button type="button" class="link-button" data-add-row="traps">{{ t('messages.contribute.fields.addTrap') }}</button>
      </fieldset>

      <fieldset class="builder__group">
        <legend>{{ t('messages.contribute.groups.layers') }}</legend>
        <p class="hint">{{ t('messages.contribute.fields.layersHint') }}</p>
        <div class="rows" data-rows="layers" data-next="{{ (problem.extraLayers ?? []).length }}">
          @each((layer, i) in problem.extraLayers)
            @!contribute.layer({ index: i, layer, es: problem.es.layers[layer.key], kinds: choices.kinds })
          @end
        </div>
        <template data-row-template="layers" data-placeholder="__i__">
          @!contribute.layer({ index: '__i__', layer: {}, kinds: choices.kinds })
        </template>
        <div class="presets">
          <button
            type="button"
            class="link-button"
            data-add-row="layers"
            data-preset="{{ presets.dpState }}"
          >
            {{ t('messages.contribute.fields.addDpState') }}
          </button>
          <button
            type="button"
            class="link-button"
            data-add-row="layers"
            data-preset="{{ presets.dpTransition }}"
          >
            {{ t('messages.contribute.fields.addDpTransition') }}
          </button>
          <button type="button" class="link-button" data-add-row="layers">
            {{ t('messages.contribute.fields.addOtherLayer') }}
          </button>
        </div>
      </fieldset>

      <fieldset class="builder__group">
        <legend>{{ t('messages.contribute.groups.other') }}</legend>
        <label class="field">
          <span>{{ t('messages.contribute.fields.notes') }} <small>{{ t('messages.contribute.fields.notesHint') }}</small></span>
          <textarea name="notes" class="input" rows="2">{{ problem.notes ?? '' }}</textarea>
        </label>
        <label class="check">
          <input type="checkbox" name="deprecated" {{ problem.deprecated ? 'checked' : '' }} />
          <span>{{ t('messages.contribute.fields.deprecated') }}</span>
        </label>
      </fieldset>

      <button type="submit" class="button">{{ t('messages.contribute.fields.update') }}</button>
    </form>
    @include('partials/contribute_preview')
  </div>
@end

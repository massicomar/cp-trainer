@layouts.main({ title: t('messages.auth.pageTitle') })
  {{-- Canvas row G, "Login": GitHub only, plus the dev login when it's on. --}}
  <section class="login card" aria-labelledby="login-title">
    <div class="login__head">
      <h1 id="login-title">{{ t('messages.auth.heading') }}</h1>
      <p class="muted">{{ t('messages.auth.intro') }}</p>
    </div>

    @flashMessage('error')
      <p class="notice notice--error" role="alert">{{ $message }}</p>
    @end

    @if(github)
      <a class="button button--github button--big button--wide" href="/auth/github">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
        </svg>
        {{ t('messages.auth.github') }}
      </a>
    @end

    @if(devLogin)
      <form class="login__dev" method="post" action="/auth/dev">
        {{ csrfField() }}
        <label class="field">
          <span>{{ t('messages.auth.dev.label') }}</span>
          <input class="input" type="text" name="username" value="dev" maxlength="39" autocomplete="off" />
        </label>
        <button type="submit" class="button">{{ t('messages.auth.dev.button') }}</button>
        <p class="hint">{{ t('messages.auth.dev.note') }}</p>
      </form>
    @end

    @if(!github && !devLogin)
      <p class="notice notice--warn">{{ t('messages.auth.unavailable') }}</p>
    @end

    <div class="login__benefits">
      <p class="label">{{ t('messages.auth.benefits.title') }}</p>
      <ul>
        @each((key, i) in ['progress', 'custom', 'soon'])
          @let(l = line(['dp', 'graphs', 'geometry'][i]))
          <li>
            <span class="line-badge line--{{ l.id }}" aria-hidden="true">{{ i + 1 }}</span>
            {{ t(`messages.auth.benefits.${key}`) }}
          </li>
        @end
      </ul>
    </div>

    @if(hasHistory)
      <p class="login__claim">{{ t('messages.auth.claim') }}</p>
    @end

    <a class="button button--wide" href="/">{{ t('messages.auth.continueWithout') }}</a>

    <p class="login__privacy">{{ t('messages.auth.privacy') }}</p>
  </section>
@end

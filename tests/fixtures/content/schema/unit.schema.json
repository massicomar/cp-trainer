{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cp-trainer.local/schema/unit.schema.json",
  "title": "CP Trainer unit (lesson)",
  "description": "units/<subject>/<name>.json: one lesson of Lecciones, about one technique (sometimes two), as a list of cards: idea → questions → signals → apply → recap. Texts are English, with an optional Spanish es on each card; anything missing falls back to English. Text fields take a small Markdown subset: paragraphs, **bold**, *italic*, `code`, - lists, and $…$ for KaTeX. Option texts are one line.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "techniques", "status", "author", "cards"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "description": "Permanent, never renamed or reused. <subject>.<name>, e.g. dp.coin-change, in units/dp/coin-change.json. Usually the id of its technique.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "techniques": {
      "description": "Technique ids from taxonomy.json, all in the unit's subject. Apply problems must have one of them as their intended technique.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "status": {
      "description": "draft = not shown in the app yet (unless CONTENT_INCLUDE_DRAFTS). ready = playable.",
      "enum": ["draft", "ready"]
    },
    "author": {
      "description": "GitHub username of whoever wrote the unit.",
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
    },
    "notes": {
      "description": "Internal notes for authors. Never shown in the app.",
      "type": "string"
    },
    "deprecated": {
      "description": "Retire a unit by setting this to true. Never delete the file.",
      "type": "boolean"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "key": {
      "description": "Permanent within the unit, like a problem id: attempts refer to it.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "text": { "type": "string", "minLength": 1 },
    "card": {
      "type": "object",
      "required": ["type", "key"],
      "properties": {
        "type": { "enum": ["idea", "diagram", "question", "drill", "signals", "apply", "recap"] },
        "key": { "$ref": "#/$defs/key" }
      },
      "allOf": [
        { "if": { "required": ["type"], "properties": { "type": { "const": "idea" } } }, "then": { "$ref": "#/$defs/textCard" } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "signals" } } }, "then": { "$ref": "#/$defs/textCard" } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "recap" } } }, "then": { "$ref": "#/$defs/textCard" } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "diagram" } } }, "then": { "$ref": "#/$defs/diagram" } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "question" } } }, "then": { "$ref": "#/$defs/question" } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "drill" } } }, "then": { "$ref": "#/$defs/drill" } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "apply" } } }, "then": { "$ref": "#/$defs/apply" } }
      ]
    },
    "textCard": {
      "description": "idea: what the technique is, a tiny example, its complexity. signals: the wording and constraints that give it away. recap: about 3 bullets, what review shows later.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "md"],
      "properties": {
        "type": { "enum": ["idea", "signals", "recap"] },
        "key": { "$ref": "#/$defs/key" },
        "md": { "$ref": "#/$defs/text" },
        "es": { "$ref": "#/$defs/text" }
      }
    },
    "question": {
      "description": "Multiple choice (2 options for true / false). It should make you use the idea: trace a small case, pick the state or the loop, spot a classic mistake, say when you'd use it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "prompt", "options", "accepted", "explanation"],
      "properties": {
        "type": { "const": "question" },
        "key": { "$ref": "#/$defs/key" },
        "prompt": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z]$" },
              "text": { "$ref": "#/$defs/text" },
              "why": {
                "description": "Shown if the player picks this option: why it's wrong (or an extra note for a correct one).",
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "accepted": {
          "description": "Option ids that count as correct. Not all of them.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]$" }
        },
        "explanation": { "$ref": "#/$defs/text" },
        "es": {
          "description": "Unlike problems, lessons are our own writing, so the prompt and the option texts are translated too.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": { "$ref": "#/$defs/text" },
            "options": { "$ref": "#/$defs/byOption" },
            "why": { "$ref": "#/$defs/byOption" },
            "explanation": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "byOption": {
      "description": "Keyed by option id.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]$" },
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "drill": {
      "description": "One algorithm drill from drills/<subject>.json, asked as \"What's the time complexity of …?\".",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "algorithm"],
      "properties": {
        "type": { "const": "drill" },
        "key": { "$ref": "#/$defs/key" },
        "algorithm": {
          "description": "<subject>:<algorithm id>, e.g. dp:coin-combinations.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "apply": {
      "description": "Bank problems played as usual, without the subject question; the technique options are the techniques already learned on that line plus this one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "problems"],
      "properties": {
        "type": { "const": "apply" },
        "key": { "$ref": "#/$defs/key" },
        "problems": {
          "description": "1 or 2 problem ids whose intended technique is one of the unit's. A ready unit needs ready problems.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "diagram": {
      "description": "A drawing that moves step by step. For dp-1d and dp-2d the author gives the input and the app computes the steps and their texts; frames are written by hand, for what the generators don't cover. Small enough to read on a phone.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "kind", "data", "caption"],
      "properties": {
        "type": { "const": "diagram" },
        "key": { "$ref": "#/$defs/key" },
        "kind": { "enum": ["dp-1d", "dp-2d", "frames"] },
        "data": { "type": "object" },
        "caption": {
          "description": "One sentence above the drawing: what the cells mean.",
          "$ref": "#/$defs/text"
        },
        "es": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "caption": { "$ref": "#/$defs/text" } }
        }
      },
      "allOf": [
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "dp-1d" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/dp1d" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "dp-2d" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/dp2d" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "frames" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/frames" } } } }
      ]
    },
    "dp1d": {
      "description": "dp[0..size−1], filled left to right: dp[i] = op over the offsets o with i − o ≥ 0 of (dp[i − o] + cost). Base cells are given; a cell with no source is 0 for sum and ∞ / −∞ for min / max.",
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "base", "recurrence"],
      "properties": {
        "size": { "type": "integer", "minimum": 2, "maximum": 12 },
        "base": {
          "description": "Index → value, e.g. { \"0\": 1 }. Indexes below size.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^(0|[1-9][0-9]?)$" },
          "additionalProperties": { "type": "number" }
        },
        "recurrence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "offsets"],
          "properties": {
            "op": { "enum": ["sum", "min", "max"] },
            "offsets": {
              "description": "How far back each source is, e.g. coin values [1, 5, 6]. Each below size.",
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            },
            "cost": {
              "description": "Added to each source, e.g. 1 for fewest coins. Default 0.",
              "type": "number"
            }
          }
        }
      }
    },
    "dp2d": {
      "description": "A table filled row by row, left to right. The recurrence decides the input.",
      "type": "object",
      "required": ["recurrence"],
      "properties": {
        "recurrence": { "enum": ["paths", "lcs", "knapsack"] }
      },
      "allOf": [
        { "if": { "required": ["recurrence"], "properties": { "recurrence": { "const": "paths" } } }, "then": { "$ref": "#/$defs/dp2dPaths" } },
        { "if": { "required": ["recurrence"], "properties": { "recurrence": { "const": "lcs" } } }, "then": { "$ref": "#/$defs/dp2dLcs" } },
        { "if": { "required": ["recurrence"], "properties": { "recurrence": { "const": "knapsack" } } }, "then": { "$ref": "#/$defs/dp2dKnapsack" } }
      ]
    },
    "dp2dPaths": {
      "description": "Paths from the top-left cell moving right or down: dp = above + left, 0 on blocked cells.",
      "type": "object",
      "additionalProperties": false,
      "required": ["recurrence", "grid"],
      "properties": {
        "recurrence": { "const": "paths" },
        "grid": {
          "description": "Rows of the same length; . is free, * is blocked. At most 6 × 6.",
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^[.*]{2,6}$" }
        }
      }
    },
    "dp2dLcs": {
      "description": "Longest common subsequence of a and b over their prefixes, with the empty prefix as row and column 0 (at most 6 × 6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["recurrence", "a", "b"],
      "properties": {
        "recurrence": { "const": "lcs" },
        "a": { "description": "Down the side.", "type": "string", "pattern": "^[A-Za-z0-9]{1,5}$" },
        "b": { "description": "Across the top.", "type": "string", "pattern": "^[A-Za-z0-9]{1,5}$" }
      }
    },
    "dp2dKnapsack": {
      "description": "0/1 knapsack: row i = the first i items, column c = capacity c, with row 0 empty (at most 6 × 6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["recurrence", "items", "capacity"],
      "properties": {
        "recurrence": { "const": "knapsack" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weight", "value"],
            "properties": {
              "weight": { "type": "integer", "minimum": 1, "maximum": 5 },
              "value": { "type": "integer", "minimum": 0, "maximum": 99 }
            }
          }
        },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "frames": {
      "description": "Hand-written steps: up to 3 rows of up to 12 cells each, some marked, plus a sentence per step.",
      "type": "object",
      "additionalProperties": false,
      "required": ["frames"],
      "properties": {
        "rows": {
          "description": "Optional label for each row, e.g. [\"a\", \"tails\"]. Every frame then has that many rows.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 8 }
        },
        "frames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cells", "text"],
            "properties": {
              "cells": {
                "description": "Rows of values; null is an empty cell.",
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "anyOf": [{ "type": "number" }, { "type": "string", "maxLength": 4 }, { "type": "null" }]
                  }
                }
              },
              "mark": {
                "description": "Cells to highlight, as [row, column].",
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "integer", "minimum": 0 }
                }
              },
              "text": { "$ref": "#/$defs/text" },
              "es": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    }
  }
}
